---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import {pillarDetails} from '../lib/content';
---
<Base title="Tentang BBN" description="Kenali asal-usul Bakul Budaya Nusantara, filosofi Sebakul, visi, dan empat pilar yang menghubungkan budaya, bumi, kebhinekaan, serta kemanusiaan.">
  <section class="page-hero"><div class="container"><div class="breadcrumb"><a href="/">Beranda</a> / Tentang BBN</div><span class="eyebrow">Mengenal Kami</span><h1>Bukan sekadar berkumpul. <em>Menumbuhkan makna.</em></h1><p>Bakul Budaya Nusantara adalah wadah perjumpaan berbagai manusia dan pengetahuan untuk merawat kebudayaan yang hidup dalam keseharian.</p></div></section>
  <section class="section"><div class="container split"><div class="body-copy"><span class="eyebrow">Filosofi Kami</span><h2>Bakul adalah wadah. Setiap orang membawa cerita.</h2><p>Bakul bukan hanya benda yang menampung. Dalam perjalanan BBN, ia menjadi simbol tempat bertemunya beragam latar, pengalaman, sudut pandang, serta praktik budaya.</p><p>Melalui kebersamaan, budaya tidak berhenti menjadi tontonan. Ia dipelajari, dipahami, dipraktikkan, dan diwariskan.</p><div class="quote">“Budaya Menyatukan Kita.”</div></div><MediaPlaceholder variant="forest" aspect="square" label="Foto kebersamaan BBN — menunggu aset resmi"/></div></section>
  <section class="section section-soft"><div class="container"><SectionHead eyebrow="Perjalanan" title="Tumbuh dari ruang perjumpaan." description="Linimasa berdasarkan catatan internal BBN. Tanggal legal yayasan perlu dipastikan dengan dokumen resmi sebelum diumumkan ke publik."/><div class="timeline"><div class="timeline-item"><div class="timeline-year">03 SEPTEMBER 2022</div><h3>Awal perjalanan di lingkungan FIB UI</h3><p>Berawal sebagai ruang berkumpul, belajar, dan berbagi kecintaan terhadap kebudayaan.</p></div><div class="timeline-item"><div class="timeline-year">PENGUATAN KELEMBAGAAN</div><h3>Perkembangan organisasi dan kelembagaan</h3><p>Informasi rinci mengenai status dan tanggal legal menunggu verifikasi dokumen dan persetujuan pengurus.</p></div><div class="timeline-item"><div class="timeline-year">HARI INI</div><h3>Membuka ruang kolaborasi yang lebih luas</h3><p>Mendorong kerja bersama lintas generasi, komunitas, institusi, dan wilayah.</p></div></div></div></section>
  <section class="section"><div class="container"><SectionHead eyebrow="Arah Bersama" title="Visi dan empat pilar misi."/><div class="split" style="align-items:start"><div><span class="eyebrow">Visi</span><h2 style="font-size:clamp(32px,4vw,49px);margin-top:18px">“Kebudayaan Indonesia menjadi jati diri bangsa seutuhnya.”</h2><p class="muted" style="margin-top:18px;font-size:13px">Rumusan sesuai catatan internal BBN; tampilkan setelah disetujui pengurus.</p></div><div class="detail-grid" style="grid-template-columns:1fr 1fr;gap:10px">{Object.values(pillarDetails).map(p=><div class="detail-card"><span class="icon">{p.icon}</span><h3 style="font-size:21px">{p.title}</h3><p>{p.description}</p></div>)}</div></div></div></section>
  <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow light">Semangat Sebakul</span><h2>Ruang ini terbuka untuk <em>semua.</em></h2><p>Dari pembelajaran budaya hingga aksi lingkungan, mari membangun perjumpaan yang menghasilkan langkah bersama.</p></div><div class="cta-actions"><a href="/program/" class="btn btn-light">Jelajahi Program ↗</a><a href="/kolaborasi/" class="btn btn-outline-light">Berkolaborasi ↗</a></div></div></section>
</Base>
