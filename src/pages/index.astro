---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProgramCard from '../components/ProgramCard.astro';
import StoryCard from '../components/StoryCard.astro';
import {getPrograms,getStories,pillarDetails} from '../lib/content';
const [programs,stories] = await Promise.all([getPrograms(),getStories()]);
---
<Base title="Beranda" description="Bakul Budaya Nusantara: ruang untuk merawat budaya, bumi, kebhinekaan, dan kemanusiaan melalui kolaborasi. Budaya Menyatukan Kita.">
  <section class="hero" aria-labelledby="hero-title"><div class="container hero-inner">
    <div class="hero-copy"><span class="eyebrow">Yayasan Bakul Budaya Nusantara</span><h1 id="hero-title">Budaya <em>Menyatukan</em> Kita.</h1><p>Dari Sebakul, terhubung se-Nusantara. Ruang perjumpaan untuk mengenal, merawat, dan menghidupkan kebudayaan melalui aksi bersama.</p><div class="hero-actions"><a class="btn btn-dark" href="/tentang/">Kenali BBN <span aria-hidden="true">↗</span></a><a class="btn btn-outline" href="/kolaborasi/">Bangun Kolaborasi <span aria-hidden="true">↗</span></a></div><div class="hero-footnote"><span class="line"></span><span>Budaya dijalani • Budaya diwariskan</span></div></div>
    <div class="hero-visual" role="img" aria-label="Ilustrasi abstrak anyaman bakul, simbol ruang perjumpaan budaya. Akan diganti dengan foto kegiatan resmi BBN."><div class="weave"><div class="weave-grid"></div><span class="weave-center">B</span></div><div class="visual-note"><strong>Filosofi Sebakul</strong>Ragam manusia, gagasan, dan budaya dalam satu ruang perjumpaan.</div><span class="visual-vertical">DARI SEBAKUL, TERHUBUNG SE-NUSANTARA</span></div>
  </div></section>
  <div class="proof-strip"><div class="container proof-inner"><p class="proof-lead">Bersama menghidupkan budaya.</p><div class="proof-item"><span>✳</span> Budaya</div><div class="proof-item"><span>❧</span> Lingkungan</div><div class="proof-item"><span>✦</span> Kebhinekaan</div><div class="proof-item"><span>◌</span> Kemanusiaan</div></div></div>
  <section class="section" aria-label="Mengenal BBN"><div class="container intro-section"><div><span class="eyebrow">Kenal Lebih Dekat</span><h2 class="intro-title">Satu bakul, <em>banyak cerita.</em></h2></div><div class="intro-body"><p>Bakul adalah wadah. Bagi kami, ia menjadi simbol ruang perjumpaan tempat keberagaman manusia, tradisi, pengetahuan, dan gagasan saling menguatkan.</p><p>Berawal dari semangat berkumpul di lingkungan Fakultas Ilmu Pengetahuan Budaya Universitas Indonesia pada 2022, BBN terus bertumbuh sebagai ruang kolaborasi budaya yang juga merawat lingkungan dan nilai kemanusiaan.</p><a class="text-link" href="/tentang/">Perjalanan dan filosofi BBN ↗</a></div></div></section>
  <section class="section section-soft" aria-label="Empat pilar misi"><div class="container"><SectionHead eyebrow="Arah Gerak Kami" title="Empat pilar, satu semangat." description="Kebudayaan bertumbuh ketika pengetahuan, alam, keberagaman, dan kemanusiaan dirawat bersama."/><div class="pillar-grid">{Object.entries(pillarDetails).map(([slug,pillar])=><a href={`/program/#${slug}`} class="pillar-card"><span class="pillar-no">{pillar.count} / PILAR</span><span class="pillar-icon" aria-hidden="true">{pillar.icon}</span><h3>{pillar.title}</h3><p>{pillar.description}</p></a>)}</div></div></section>
  <section class="section" aria-label="Program BBN"><div class="container"><SectionHead eyebrow="Yang Kami Lakukan" title="Budaya yang terus bergerak." description="Berbagai ruang belajar, kegiatan kreatif, dan aksi kolektif yang menyatukan banyak orang." link="/program/" linkText="Semua program"/><div class="program-grid">{programs.slice(0,4).map((program,index)=><ProgramCard program={program} index={index}/>)}</div></div></section>
  <section class="section section-soft" aria-label="Cerita terbaru"><div class="container"><SectionHead eyebrow="Catatan dari Sebakul" title="Cerita yang layak dibagikan." description="Kabar kegiatan, pengetahuan budaya, dan dokumentasi yang akan terus diperbarui oleh pengurus." link="/cerita/" linkText="Buka ruang cerita"/><div class="story-grid">{stories.length ? stories.slice(0,3).map((story,index)=><StoryCard story={story} index={index}/>) : <div class="empty-panel empty-wide"><strong>Ruang cerita sedang dipersiapkan.</strong><p>Artikel resmi akan muncul di sini setelah pengurus mengunggah dan menerbitkannya melalui Sanity CMS. Tidak ada berita atau data kegiatan yang dibuat-buat.</p><a href="/cerita/" class="text-link" style="align-self:flex-start;margin-top:10px">Jelajahi Cerita Budaya ↗</a></div>}</div></div></section>
  <section class="section" aria-label="Jejak karya"><div class="container split"><div><span class="eyebrow">Rekam Jejak</span><h2 class="intro-title">Jejak kecil, makna yang panjang.</h2><div class="chips"><span class="chip">Sabtu Sebakul</span><span class="chip">Sedekah Hutan</span><span class="chip">Gerak Anak</span><span class="chip">Bincang Budaya</span></div></div><div class="intro-body"><p>Setiap program menyimpan cerita di balik pelaksanaannya: siapa yang dipertemukan, pengetahuan apa yang dibagikan, dan nilai apa yang dirawat.</p><p>Kami sedang menyiapkan arsip kegiatan serta dokumentasi yang dapat dipertanggungjawabkan sebagai bahan pengenalan bagi masyarakat dan calon mitra.</p><a href="/jejak-karya/" class="text-link">Jelajahi jejak karya ↗</a></div></div></section>
  <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow light">Ruang Kolaborasi Nusantara</span><h2>Mari membuat cerita <em>bersama.</em></h2><p>Kepada pemerintah, badan penghubung daerah, akademisi, komunitas, serta mitra sosial: mari membuka percakapan dan merancang inisiatif budaya yang berdampak.</p></div><div class="cta-actions"><a class="btn btn-light" href="/kolaborasi/">Jelajahi Peluang Kolaborasi ↗</a><a class="btn btn-outline-light" href="/tentang/">Kenali Organisasi ↗</a></div></div></section>
</Base>
